  <data name="AboutPageTitle" xml:space="preserve"><value>About SlopClean</value></data>
  <data name="AboutBlurb" xml:space="preserve"><value>SlopClean is a free, open-source Windows cleanup and optimization tool without ads or telemetry.</value></data>
  <data name="AboutVersionFormat" xml:space="preserve"><value>Version {0}</value></data>
