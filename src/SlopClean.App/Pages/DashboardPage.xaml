<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SlopClean.App.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SlopClean.App.Controls"
    xmlns:vm="using:SlopClean.App.ViewModels">
    <ScrollViewer Padding="24">
        <StackPanel Spacing="16">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Dashboard" />
            <TextBlock TextWrapping="Wrap" Text="Scan your system for cleanup opportunities. Preview always comes before any change." />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    Command="{x:Bind ViewModel.ScanAllCommand}"
                    Content="Quick Scan"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button Command="{x:Bind ViewModel.CancelCommand}" Content="Cancel" />
            </StackPanel>

            <controls:ScanProgressControl
                IsBusy="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                StatusText="{x:Bind ViewModel.StatusText, Mode=OneWay}" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Findings" />
                        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.FindingCount, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border
                    Grid.Column="1"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Recoverable" />
                        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.TotalSizeText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Modules" />
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Modules}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        MinItemWidth="260"
                        MinRowSpacing="12"
                        MinColumnSpacing="12" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModuleSummaryViewModel">
                        <controls:ModuleCard
                            Category="{x:Bind Category}"
                            Description="{x:Bind Description}"
                            ModuleId="{x:Bind Id}"
                            Title="{x:Bind Name}"
                            OpenRequested="ModuleCard_OpenRequested" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
