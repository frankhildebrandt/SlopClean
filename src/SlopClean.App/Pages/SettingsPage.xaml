<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SlopClean.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="640">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />

            <TextBlock Text="Theme" />
            <ComboBox
                Width="240"
                ItemsSource="{x:Bind ViewModel.Themes}"
                SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=OneWay}"
                SelectionChanged="ThemeComboBox_SelectionChanged" />

            <TextBlock Text="Language" />
            <ComboBox
                Width="240"
                ItemsSource="{x:Bind ViewModel.Languages}"
                SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=OneWay}"
                SelectionChanged="LanguageComboBox_SelectionChanged" />

            <TextBlock Text="Backup directory" />
            <TextBlock
                Opacity="0.75"
                TextWrapping="Wrap"
                Text="Backups created before applying changes are stored here and can be restored from the Restore page." />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="BackupDirectoryBox"
                    Text="{x:Bind ViewModel.BackupDirectory, Mode=OneWay}"
                    LostFocus="BackupDirectoryBox_LostFocus" />
                <Button
                    Grid.Column="1"
                    Command="{x:Bind ViewModel.BrowseBackupFolderCommand}"
                    Content="Browse..." />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    Command="{x:Bind ViewModel.SaveBackupDirectoryCommand}"
                    Content="Save backup path"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button Command="{x:Bind ViewModel.OpenBackupFolderCommand}" Content="Open backup folder" />
            </StackPanel>

            <Button Command="{x:Bind ViewModel.OpenLogFolderCommand}" Content="Open log folder" />
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />

            <InfoBar
                IsOpen="True"
                IsClosable="False"
                Severity="Informational"
                Title="Privacy"
                Message="SlopClean stores logs and backups locally only. Paths are redacted. No telemetry is sent." />
        </StackPanel>
    </ScrollViewer>
</Page>
