<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SlopClean.App.Pages.ReviewPlanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SlopClean.App.Controls">
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
            <TextBlock TextWrapping="Wrap" Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" />
        </StackPanel>

        <InfoBar
            Grid.Row="1"
            IsOpen="True"
            IsClosable="False"
            Severity="Informational"
            Title="Preview first"
            Message="Nothing has been changed yet. Apply creates backups where possible, then performs the selected actions." />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button Command="{x:Bind ViewModel.BackCommand}" Content="Back" />
            <Button
                Command="{x:Bind ViewModel.ApplyPlanCommand}"
                Content="Apply"
                Style="{StaticResource AccentButtonStyle}"
                IsEnabled="{x:Bind ViewModel.CanApply, Mode=OneWay}" />
            <Button Command="{x:Bind ViewModel.CancelCommand}" Content="Cancel" />
        </StackPanel>

        <controls:PlannedChangeList
            Grid.Row="3"
            Items="{x:Bind ViewModel.Changes}" />

        <controls:ScanProgressControl
            Grid.Row="4"
            IsBusy="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
            StatusText="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
    </Grid>
</Page>
