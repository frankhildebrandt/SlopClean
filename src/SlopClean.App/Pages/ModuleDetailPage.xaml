<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SlopClean.App.Pages.ModuleDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SlopClean.App.Controls">
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="72" Height="72" CornerRadius="16">
                <Image
                    Width="72"
                    Height="72"
                    Stretch="Uniform"
                    Source="{x:Bind ViewModel.Illustration, Mode=OneWay}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
                <TextBlock TextWrapping="Wrap" Text="{x:Bind ViewModel.Description, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <controls:ParameterForm
            Grid.Row="1"
            Items="{x:Bind ViewModel.Parameters}" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button
                Command="{x:Bind ViewModel.ScanCommand}"
                Content="Scan"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                Command="{x:Bind ViewModel.ReviewSelectedCommand}"
                Content="Review selected"
                IsEnabled="{x:Bind ViewModel.CanReview, Mode=OneWay}" />
            <Button Command="{x:Bind ViewModel.SelectAllCommand}" Content="Select all" />
            <Button Command="{x:Bind ViewModel.SelectNoneCommand}" Content="Select none" />
            <Button Command="{x:Bind ViewModel.CancelCommand}" Content="Cancel" />
        </StackPanel>

        <controls:FindingList
            Grid.Row="3"
            Items="{x:Bind ViewModel.Findings}" />

        <controls:ScanProgressControl
            Grid.Row="4"
            IsBusy="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
            StatusText="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
    </Grid>
</Page>
