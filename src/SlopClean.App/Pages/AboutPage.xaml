<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SlopClean.App.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SlopClean.App.Models">
    <ScrollViewer Padding="24">
        <StackPanel Spacing="12" MaxWidth="720">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Border Width="72" Height="72" CornerRadius="16">
                    <Image
                        Width="72"
                        Height="72"
                        Stretch="Uniform"
                        Source="ms-appx:///Assets/BrandMark.png" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="4">
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.Title}" />
                    <TextBlock Text="{x:Bind ViewModel.VersionText}" />
                </StackPanel>
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Text="{x:Bind ViewModel.Blurb}" />

            <StackPanel Orientation="Horizontal" Spacing="16">
                <HyperlinkButton
                    Content="{x:Bind ViewModel.SourceLabel}"
                    NavigateUri="{x:Bind ViewModel.SourceUrl}" />
                <HyperlinkButton
                    Content="{x:Bind ViewModel.LicenseLabel}"
                    NavigateUri="{x:Bind ViewModel.LicenseUrl}" />
            </StackPanel>

            <TextBlock TextWrapping="Wrap" Text="{x:Bind ViewModel.ReviewHint}" />

            <Border
                Margin="0,8,0,0"
                Padding="16"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                BorderThickness="2"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border
                            Padding="10,4"
                            CornerRadius="4"
                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Text="{x:Bind ViewModel.EuAiActBadge}" />
                        </Border>
                        <Border
                            Padding="10,4"
                            CornerRadius="4"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderThickness="1"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.EuAiActProvenance}" />
                        </Border>
                    </StackPanel>
                    <TextBlock
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.EuAiActTitle}" />
                    <TextBlock
                        Opacity="0.8"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap"
                        Text="{x:Bind ViewModel.EuAiActMeta}" />
                    <TextBlock TextWrapping="Wrap" Text="{x:Bind ViewModel.EuAiActBody}" />
                </StackPanel>
            </Border>

            <TextBlock
                Margin="0,12,0,0"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind ViewModel.OpenSourceSectionTitle}" />

            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Credits}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="16" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:OpenSourceCredit">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <HyperlinkButton
                                    Padding="0"
                                    Content="{x:Bind Name}"
                                    NavigateUri="{x:Bind ProjectUrl}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Opacity="0.75"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind LicenseId}" />
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" Text="{x:Bind Excerpt}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
