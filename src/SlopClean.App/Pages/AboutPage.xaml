<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SlopClean.App.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="24">
        <StackPanel Spacing="12" MaxWidth="720">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="About SlopClean" />
            <TextBlock TextWrapping="Wrap" Text="SlopClean is a free, open-source Windows cleanup and optimization tool without ads or telemetry." />
            <TextBlock Text="Version 0.1.0" />
            <TextBlock TextWrapping="Wrap" Text="License: GNU Affero General Public License v3.0 or later (AGPL-3.0-or-later)" />
            <TextBlock TextWrapping="Wrap" Text="Source code and contributions are welcome. Always review scan results before applying changes." />
        </StackPanel>
    </ScrollViewer>
</Page>
