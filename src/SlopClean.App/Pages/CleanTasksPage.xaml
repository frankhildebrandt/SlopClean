<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SlopClean.App.Pages.CleanTasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SlopClean.App.Controls">
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Clean Tasks" />
            <TextBlock TextWrapping="Wrap" Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" />
        </StackPanel>

        <InfoBar
            Grid.Row="1"
            IsOpen="True"
            IsClosable="False"
            Severity="Informational"
            Title="Todo-style cleanup"
            Message="Each selected cleanup action appears here as a task. Watch status update while the run progresses." />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button
                Command="{x:Bind ViewModel.StartCommand}"
                Content="Start"
                Style="{StaticResource AccentButtonStyle}"
                IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}" />
            <Button Command="{x:Bind ViewModel.CancelCommand}" Content="Cancel" />
            <Button
                Command="{x:Bind ViewModel.ClearCompletedCommand}"
                Content="Clear completed"
                IsEnabled="{x:Bind ViewModel.CanClear, Mode=OneWay}" />
        </StackPanel>

        <controls:CleanTaskList
            Grid.Row="3"
            Items="{x:Bind ViewModel.Tasks}" />

        <controls:ScanProgressControl
            Grid.Row="4"
            IsBusy="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
            StatusText="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
    </Grid>
</Page>
