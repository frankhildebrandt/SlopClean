<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>SlopClean.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- `dotnet build` on the .slnx often passes AnyCPU; WinAppSDK self-contained needs a real arch. -->
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <LangVersion>preview</LangVersion>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\BrandMark.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.2" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SlopClean.Core\SlopClean.Core.csproj" />
    <ProjectReference Include="..\SlopClean.Modules\SlopClean.Modules.csproj" />
    <ProjectReference Include="..\SlopClean.Platform.Windows\SlopClean.Platform.Windows.csproj" />
    <ProjectReference Include="..\SlopClean.Elevated\SlopClean.Elevated.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    Copy self-contained WinUI helper into TargetDir\elevated\ (preserve subfolders).
    Publish path publishes SC helper into PublishDir\elevated\ (see PublishElevatedHelper).
  -->
  <Target Name="ResolveElevatedHelperOutput">
    <MSBuild
      Projects="$(MSBuildThisFileDirectory)..\SlopClean.Elevated\SlopClean.Elevated.csproj"
      Targets="GetTargetPath"
      Properties="Configuration=$(Configuration);Platform=$(Platform);RuntimeIdentifier=win-x64">
      <Output TaskParameter="TargetOutputs" ItemName="_ElevatedTargetPathItem" />
    </MSBuild>
    <PropertyGroup>
      <_ElevatedOut Condition="'@(_ElevatedTargetPathItem)' != ''">$([System.IO.Path]::GetDirectoryName('@(_ElevatedTargetPathItem)'))\</_ElevatedOut>
      <_ElevatedOut Condition="'$(_ElevatedOut)' == '' or !Exists('$(_ElevatedOut)SlopClean.Elevated.exe')">$(MSBuildThisFileDirectory)..\SlopClean.Elevated\bin\$(Platform)\$(Configuration)\net10.0-windows10.0.19041.0\win-x64\</_ElevatedOut>
      <_ElevatedOut Condition="!Exists('$(_ElevatedOut)SlopClean.Elevated.exe')">$(MSBuildThisFileDirectory)..\SlopClean.Elevated\bin\$(Configuration)\net10.0-windows10.0.19041.0\win-x64\</_ElevatedOut>
    </PropertyGroup>
  </Target>

  <Target Name="CopyElevatedHelper"
          AfterTargets="CopyFilesToOutputDirectory"
          BeforeTargets="_CleanRecordFileWrites"
          DependsOnTargets="ResolveElevatedHelperOutput">
    <PropertyGroup>
      <_ElevatedDest>$(TargetDir)elevated\</_ElevatedDest>
    </PropertyGroup>
    <ItemGroup>
      <_ElevatedSourceFiles Include="$(_ElevatedOut)**\*.*" Condition="Exists('$(_ElevatedOut)SlopClean.Elevated.exe')" />
    </ItemGroup>
    <Error
      Condition="!Exists('$(_ElevatedOut)SlopClean.Elevated.exe')"
      Text="SlopClean.Elevated output not found. Build SlopClean.Elevated before the App (looked under '$(_ElevatedOut)')." />
    <MakeDir Directories="$(_ElevatedDest)" />
    <Copy
      SourceFiles="@(_ElevatedSourceFiles)"
      DestinationFiles="@(_ElevatedSourceFiles->'$(_ElevatedDest)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="false" />
    <Error
      Condition="!Exists('$(_ElevatedDest)SlopClean.Elevated.dll') or !Exists('$(_ElevatedDest)SlopClean.Elevated.exe')"
      Text="Elevated helper incomplete under '$(_ElevatedDest)' (expected SlopClean.Elevated.exe and .dll)." />
    <ItemGroup>
      <FileWrites Include="@(_ElevatedSourceFiles->'$(_ElevatedDest)%(RecursiveDir)%(Filename)%(Extension)')" />
    </ItemGroup>
  </Target>

  <Target Name="PublishElevatedHelper" AfterTargets="Publish">
    <PropertyGroup>
      <_ElevatedPublishDir>$(PublishDir)elevated\</_ElevatedPublishDir>
    </PropertyGroup>
    <MakeDir Directories="$(_ElevatedPublishDir)" />
    <MSBuild
      Projects="$(MSBuildThisFileDirectory)..\SlopClean.Elevated\SlopClean.Elevated.csproj"
      Targets="Publish"
      Properties="Configuration=$(Configuration);Platform=$(Platform);RuntimeIdentifier=win-x64;SelfContained=true;PublishDir=$(_ElevatedPublishDir);PublishSingleFile=false;PublishTrimmed=false" />
    <Error
      Condition="!Exists('$(_ElevatedPublishDir)SlopClean.Elevated.exe') or !Exists('$(_ElevatedPublishDir)SlopClean.Elevated.dll')"
      Text="Self-contained elevated helper incomplete under '$(_ElevatedPublishDir)'." />
  </Target>
</Project>

