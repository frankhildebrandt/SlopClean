<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>SlopClean.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- `dotnet build` on the .slnx often passes AnyCPU; WinAppSDK self-contained needs a real arch. -->
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <LangVersion>preview</LangVersion>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.2" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SlopClean.Core\SlopClean.Core.csproj" />
    <ProjectReference Include="..\SlopClean.Modules\SlopClean.Modules.csproj" />
    <ProjectReference Include="..\SlopClean.Platform.Windows\SlopClean.Platform.Windows.csproj" />
    <ProjectReference Include="..\SlopClean.Elevated\SlopClean.Elevated.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyElevatedHelper" AfterTargets="Build;Publish">
    <PropertyGroup>
      <_ElevatedOut>$(MSBuildThisFileDirectory)..\SlopClean.Elevated\bin\$(Platform)\$(Configuration)\net10.0-windows10.0.19041.0\</_ElevatedOut>
      <_ElevatedOut Condition="!Exists('$(_ElevatedOut)SlopClean.Elevated.exe')">$(MSBuildThisFileDirectory)..\SlopClean.Elevated\bin\$(Configuration)\net10.0-windows10.0.19041.0\</_ElevatedOut>
      <_CopyDest Condition="'$(PublishDir)' != ''">$(PublishDir)</_CopyDest>
      <_CopyDest Condition="'$(PublishDir)' == ''">$(OutputPath)</_CopyDest>
    </PropertyGroup>
    <ItemGroup>
      <_ElevatedFiles Include="$(_ElevatedOut)**\*.*" Condition="Exists('$(_ElevatedOut)SlopClean.Elevated.exe')" />
    </ItemGroup>
    <Copy SourceFiles="@(_ElevatedFiles)" DestinationFolder="$(_CopyDest)" SkipUnchangedFiles="true" Condition="'@(_ElevatedFiles)' != ''" />
  </Target>
</Project>

