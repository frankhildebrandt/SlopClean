<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="SlopClean.App.Controls.ModuleCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Button
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        Click="Open_Click"
        Padding="0">
        <Border
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            MinHeight="120">
            <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Category, Mode=OneWay}" />
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind Title, Mode=OneWay}" />
                <TextBlock
                    TextWrapping="Wrap"
                    Opacity="0.8"
                    Text="{x:Bind Description, Mode=OneWay}" />
            </StackPanel>
        </Border>
    </Button>
</UserControl>
