<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="SlopClean.App.Controls.CleanTaskList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SlopClean.App.ViewModels">
    <ListView ItemsSource="{x:Bind Items, Mode=OneWay}" SelectionMode="None">
        <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:CleanTaskItemViewModel">
                <Grid Padding="8,8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Glyph="{x:Bind Glyph, Mode=OneWay}"
                        VerticalAlignment="Center"
                        FontSize="18" />
                    <StackPanel Grid.Column="1">
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                        <TextBlock
                            Opacity="0.75"
                            TextTrimming="CharacterEllipsis"
                            Text="{x:Bind Details}" />
                        <TextBlock
                            Opacity="0.65"
                            FontSize="12"
                            Text="{x:Bind Message, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Text="{x:Bind SizeText}" />
                    <TextBlock
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        MinWidth="80"
                        Text="{x:Bind StatusText, Mode=OneWay}" />
                </Grid>
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
</UserControl>
