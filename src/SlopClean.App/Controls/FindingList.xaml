<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="SlopClean.App.Controls.FindingList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SlopClean.App.ViewModels">
    <ListView
        ItemsSource="{x:Bind Items, Mode=OneWay}"
        SelectionMode="None">
        <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:FindingItemViewModel">
                <Grid Padding="8,6" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox
                        IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                        IsEnabled="{x:Bind IsActionable}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                        <TextBlock
                            Opacity="0.75"
                            TextTrimming="CharacterEllipsis"
                            Text="{x:Bind Details}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind SizeText}" />
                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{x:Bind RiskText}" />
                </Grid>
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
</UserControl>
