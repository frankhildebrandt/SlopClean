<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="SlopClean.App.Controls.ParameterForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SlopClean.App.ViewModels">
    <Border
        Padding="12"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        CornerRadius="8">
        <ItemsRepeater ItemsSource="{x:Bind Items, Mode=OneWay}">
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:ParameterItemViewModel">
                    <Grid Margin="0,0,0,12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                            <TextBlock
                                Opacity="0.75"
                                TextWrapping="Wrap"
                                Text="{x:Bind Description}" />
                        </StackPanel>
                        <!-- x:Load avoids collapsed NumberBox/ComboBox TwoWay bindings overwriting bool values.
                             Typed accessors must still be fail-safe: WinUI may evaluate binds for unloaded editors. -->
                        <ToggleSwitch
                            x:Name="BoolEditor"
                            Grid.Column="1"
                            x:Load="{x:Bind IsBool}"
                            IsOn="{x:Bind BoolValue, Mode=TwoWay}" />
                        <NumberBox
                            x:Name="IntEditor"
                            Grid.Column="1"
                            x:Load="{x:Bind IsInt}"
                            Minimum="0"
                            SpinButtonPlacementMode="Inline"
                            Value="{x:Bind IntValue, Mode=TwoWay}" />
                        <ComboBox
                            x:Name="EnumEditor"
                            Grid.Column="1"
                            x:Load="{x:Bind IsEnum}"
                            ItemsSource="{x:Bind EnumValues}"
                            SelectedItem="{x:Bind StringValue, Mode=TwoWay}" />
                        <TextBox
                            x:Name="PathListEditor"
                            Grid.Column="1"
                            x:Load="{x:Bind IsPathList}"
                            AcceptsReturn="True"
                            MinHeight="64"
                            TextWrapping="Wrap"
                            PlaceholderText="One path per line"
                            Text="{x:Bind PathsText, Mode=TwoWay}" />
                    </Grid>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
    </Border>
</UserControl>
